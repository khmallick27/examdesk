# PostgreSQL connection (Supabase: Project Settings -> Database -> Connection string, "Session pooler" URI)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
# First administrator, created only when the faculty table is empty
ADMIN_EMAIL=examcell@rmgec.ac.in
ADMIN_PASSWORD=change-this-to-a-long-password
NODE_ENV=production
PORT=3000
# Reverse proxies in front of the app (1 on Render/Railway/Nginx) so rate limits see real client IPs
TRUST_PROXY=1
# PGSSL=off   # only for a local Postgres without TLS
